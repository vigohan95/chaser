# ---------- PayPal (sandbox app from https://developer.paypal.com/dashboard/applications/sandbox) ----------
# Leave both empty (or set MOCK_PAYPAL=1) to run the full product against the built-in mock PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Webhook id from Dashboard > your app > Webhooks (only needed for /api/webhooks/paypal signature checks)
PAYPAL_WEBHOOK_ID=
# Force mock PayPal even if credentials are present (1 = mock, 0 = sandbox)
MOCK_PAYPAL=1

# ---------- LLM (pick ONE free tier; with none set, the deterministic mock planner is used) ----------
# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Nebius Token Factory (NVIDIA Nemotron) - OpenAI-compatible
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# With several keys set, pick the provider explicitly (nebius | google | groq)
LLM_PROVIDER=
# Tavily news search for payer signals (https://app.tavily.com, free tier, no card). Unset = labelled demo signals.
TAVILY_API_KEY=
# Force demo signals even with a Tavily key
MOCK_SIGNALS=
# Optional model override for whichever provider is active (e.g. gemini-2.5-flash-lite, llama-3.3-70b-versatile)
LLM_MODEL=
# Force the mock planner even if a key is present
MOCK_LLM=0
# Daily caps for the hosted LLM (per visitor ip and across all visitors, UTC days). Past the cap the keyless
# rule planner takes over, so a free-tier key can sit on a public deployment without being burned.
AGENT_LLM_RUNS_PER_IP_PER_DAY=20
AGENT_LLM_RUNS_PER_DAY=300

# ---------- Merchant identity shown on invoices ----------
MERCHANT_BUSINESS_NAME=Vigo Design Studio
MERCHANT_GIVEN_NAME=Han
MERCHANT_SURNAME=Vigo
MERCHANT_EMAIL=sb-merchant@business.example.com
MERCHANT_CURRENCY=USD

# ---------- Ops ----------
# Protects /api/cron/collections (Vercel sets the Authorization: Bearer header automatically when this is set)
CRON_SECRET=
# Allow POST /api/seed to create demo invoices in the PayPal sandbox from the UI
ALLOW_SANDBOX_SEED=0
